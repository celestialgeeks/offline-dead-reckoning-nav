{
  "expo": {
    "name": "Bharat Maps",
    "slug": "ps-168",
    "version": "1.0.12",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Bharat Maps needs your location to show your position on the map and track navigation accuracy."
      }
    },
    "android": {
      "versionCode": 13,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "package": "com.bharatmaps.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@maplibre/maplibre-react-native",
      "expo-sharing",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Bharat Maps needs your location to show your position on the map.",
          "locationWhenInUsePermission": "Bharat Maps needs your location to show your position on the map."
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "ps168-navigator"
      }
    }
  }
}
